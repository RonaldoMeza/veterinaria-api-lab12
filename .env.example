# Plantilla de desarrollo. No reemplazar los marcadores en este archivo ni subir .env.
# ASP.NET Core no carga .env automáticamente; para local use User Secrets.

ConnectionStrings__Veterinaria=Server=tcp:<servidor>.database.windows.net,1433;Initial Catalog=<base-de-datos>;User ID=<usuario-azure-sql>;Password=<contrasena-azure-sql>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
Cors__AllowedOrigin=http://localhost:3000
